@model GRUPO3.Models.Estudiante

@{
    ViewData["Title"] = "Eliminar Estudiante";
}

<h1>Eliminar este estudiante</h1>

<h3>¿Está seguro de eliminar a este estudiante?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Apellido)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Apellido)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.CedulaIdentidad)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.CedulaIdentidad)
        </dd>
    </dl>
    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>

    </form>
