@model GRUPO3.Models.Maestro

@{
    ViewData["Title"] = "Eliminar Maestro";
}

<h1>Eliminar Maestro</h1>

<h3>¿Está seguro de que desea eliminar este maestro?</h3>

<div>
    <h4>Información del Maestro</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Apellido)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Apellido)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Especialidad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Especialidad)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <input type="submit"
               value="Eliminar Maestro"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Volver a la lista
        </a>
    </form>
</div>
