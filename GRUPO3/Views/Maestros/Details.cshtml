@model GRUPO3.Models.Maestro

@{
    ViewData["Title"] = "Detalles del Maestro";
}

<h1>Detalles del Maestro</h1>

<div>
    <h4>Información del Maestro</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Apellido)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Apellido)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Especialidad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Especialidad)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model?.Id"
       class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>
</div>
