@page
@model GRUPO3.Controllers.AulasController.IndexModel

<h1>Aulas</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Aulas[0].Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Aulas[0].Descripcion)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Aulas)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                <td>
                    <a asp-page="/Aulas/Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="/Aulas/Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="/Aulas/Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>